# ==============================================================================
# TAXVAT LAWAID — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your real project credentials.
# NEVER commit .env.local or expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# ==============================================================================

# 1. Supabase Configuration (Required for Backend, Database & Admin Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Public Site URL (Used for SEO canonical tags & Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://www.taxvatlawaid.com

# 3. Ads & Analytics Tracking (Optional — leave blank until ready to activate)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# 4. Admin Email Notification (Optional — powered by Resend API if provided)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=taxvatlawaid@gmail.com
EMAIL_FROM=TaxVat LawAid Desk <onboarding@resend.dev>
