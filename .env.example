# ==============================================================================
# TAXVAT LAWAID — ENVIRONMENT CONFIGURATION (MONGODB ATLAS)
# Copy this file to .env.local and set your real credentials.
# NEVER commit .env.local or expose MONGODB_URI / ADMIN_JWT_SECRET to browsers.
# ==============================================================================

# 1. MongoDB Atlas Configuration (Server-Only)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/TaxvatlawaidLandingpage?appName=Cluster0
MONGODB_DB=TaxvatlawaidLandingpage

# 2. Admin Authentication (Server-Only)
# Generate a strong random string (e.g. openssl rand -hex 32)
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars
ADMIN_SEED_EMAIL=taxvatlawaid@gmail.com
ADMIN_SEED_PASSWORD=ChangeThisStrongPassword!2026

# 3. Public Site URL (Used for SEO canonical tags & Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://www.taxvatlawaid.com

# 4. Ads & Analytics Tracking (Optional — leave blank until ready to activate)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# 5. Admin Email Notification (Optional — powered by Resend API if provided)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=taxvatlawaid@gmail.com
EMAIL_FROM=TaxVat LawAid Desk <onboarding@resend.dev>
